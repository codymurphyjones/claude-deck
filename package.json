{
  "name": "claude-deck",
  "productName": "Claude Deck",
  "version": "0.12.0",
  "description": "A desktop command center for Claude Code terminals",
  "main": "./out/main/index.js",
  "author": "magerx1794",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test -c tests/e2e/playwright.config.ts",
    "format:check": "node scripts/format-check.mjs",
    "format": "node scripts/format-check.mjs --write",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@replit/codemirror-minimap": "^0.5.2",
    "electron-updater": "^6.8.9",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^16.0.0",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.magerx.claudedeck",
    "productName": "Claude Deck",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "node_modules/typescript",
        "to": "typescript",
        "filter": [
          "package.json",
          "LICENSE.txt",
          "lib/typescript.js",
          "lib/lib.*.d.ts"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Claude-Deck-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "codymurphyjones",
        "repo": "claude-deck"
      }
    ]
  },
  "repository": "github:codymurphyjones/claude-deck",
  "homepage": "https://github.com/codymurphyjones/claude-deck",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
